{
  "name": "portfolio",
  "version": "1.2.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint:next": "next lint",
    "run": "concurrently -k -p \"[{name}]\" -n \"Next.js,Vercel CLI,Backend\" -c \"white.bold,cyan.bold\" \"next dev\" \"cross-env VERCEL_BUILDER_DEBUG=true vercel dev --yes\" \"cd backend && cargo shuttle run\"",
    "format": "bun run biome format --write ./src",
    "lint": "bun run biome lint ./src",
    "check": "bun run biome check --write ./src",
    "prepare": "husky",
    "test": "jest",
    "e2e:headless": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@emotion/cache": "^11.13.5",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@hookform/resolvers": "^3.9.1",
    "@jest/globals": "^29.7.0",
    "@mui/icons-material": "^6.1.9",
    "@mui/material": "^6.1.9",
    "@mui/material-nextjs": "^6.1.9",
    "@mui/utils": "^6.1.9",
    "@mui/x-data-grid": "^7.23.0",
    "@reduxjs/toolkit": "^2.4.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "cross-env": "^7.0.3",
    "eslint-config-next": "^15.0.3",
    "jiti": "^2.4.1",
    "markdown-to-jsx": "^7.7.0",
    "motion": "^11.12.0",
    "next": "^15.0.3",
    "next-auth": "^5.0.0-beta.25",
    "next-intl": "^3.25.3",
    "next-redux-wrapper": "^8.1.0",
    "notistack": "^3.0.1",
    "playwright": "^1.49.0",
    "postcss": "8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-icons": "^5.3.0",
    "react-redux": "^9.1.2",
    "redux-persist": "^6.0.0",
    "tailwindcss": "3.4.15",
    "typescript": "5.7.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/sdk-trace-node": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.10",
    "postinstall-postinstall": "^2.1.0",
    "ts-jest": "^29.2.5"
  },
  "lint-staged": {
    "*.{ts,tsx,d.ts}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
