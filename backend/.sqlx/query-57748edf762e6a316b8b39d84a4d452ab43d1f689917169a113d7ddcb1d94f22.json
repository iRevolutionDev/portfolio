  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, title, content, image_url, user_id, published, created_at, updated_at\n        FROM posts\n        WHERE ($1::text IS NULL OR title ILIKE $1)\n        AND ($2::text IS NULL OR content ILIKE $2)\n        LIMIT $3 OFFSET $4\n        ",
